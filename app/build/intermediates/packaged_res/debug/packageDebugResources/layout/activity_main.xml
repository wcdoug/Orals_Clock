<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="16dp">

    <!-- App title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/colorTimerTextDefault"
        android:textSize="18sp"
        android:alpha="0.7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Play/Pause and Reset buttons row — moved to top -->
    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Giant Play/Pause button -->
        <Button
            android:id="@+id/btnPlayPause"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="3"
            android:layout_marginEnd="12dp"
            android:text="@string/btn_play"
            android:textColor="@color/colorPlayButtonText"
            android:textSize="26sp"
            android:textStyle="bold"
            android:backgroundTint="@color/colorPlayButton" />

        <!-- Reset button -->
        <Button
            android:id="@+id/btnReset"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:text="@string/btn_reset"
            android:textColor="@color/colorResetButtonText"
            android:textSize="18sp"
            android:backgroundTint="@color/colorResetButton" />

    </LinearLayout>

    <!-- Giant countdown display -->
    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="00:00"
        android:textColor="@color/colorTimerTextDefault"
        android:textSize="200sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="80sp"
        android:autoSizeMaxTextSize="200sp"
        app:layout_constraintTop_toBottomOf="@id/actionRow"
        app:layout_constraintBottom_toTopOf="@id/presetRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Preset time buttons row -->
    <LinearLayout
        android:id="@+id/presetRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/customRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn30"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="30 min"
            android:textColor="@color/colorPresetButtonText"
            android:textSize="14sp"
            android:backgroundTint="@color/colorPresetButton" />

        <Button
            android:id="@+id/btn40"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="40 min"
            android:textColor="@color/colorPresetButtonText"
            android:textSize="14sp"
            android:backgroundTint="@color/colorPresetButton" />

        <Button
            android:id="@+id/btn60"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="60 min"
            android:textColor="@color/colorPresetButtonText"
            android:textSize="14sp"
            android:backgroundTint="@color/colorPresetButton" />

        <Button
            android:id="@+id/btn90"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="90 min"
            android:textColor="@color/colorPresetButtonText"
            android:textSize="14sp"
            android:backgroundTint="@color/colorPresetButton" />

        <Button
            android:id="@+id/btn120"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="120 min"
            android:textColor="@color/colorPresetButtonText"
            android:textSize="14sp"
            android:backgroundTint="@color/colorPresetButton" />

    </LinearLayout>

    <!-- Custom time entry row -->
    <LinearLayout
        android:id="@+id/customRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_custom"
            android:textColor="@color/colorPresetButtonText"
            android:textSize="16sp"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etCustomMinutes"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="@string/hint_custom"
            android:textColor="@color/colorTimerTextDefault"
            android:textColorHint="@color/colorResetButtonText"
            android:textSize="18sp"
            android:gravity="center"
            android:maxLength="3"
            android:background="@android:drawable/edit_text"
            android:backgroundTint="@color/colorPresetButtonText"
            android:imeOptions="actionDone" />

        <Button
            android:id="@+id/btnSet"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="@string/btn_set"
            android:textColor="@color/colorPlayButtonText"
            android:backgroundTint="@color/colorPlayButton"
            android:textSize="16sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
